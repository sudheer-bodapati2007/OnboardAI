PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_atlas_connection_string_here
# Optional — DNS resolver(s) for MongoDB Atlas SRV lookups (comma-separated).
# Defaults to 8.8.8.8. Only applied to mongodb+srv:// URIs.
# DNS_SERVERS=8.8.8.8
GOOGLE_CLIENT_ID=your_google_oauth2_client_id_here
JWT_SECRET=a_long_random_string_at_least_32_chars_here
CLIENT_URL=http://localhost:5173
ADMIN_SEED_EMAIL=your_admin_email@yourdomain.com

# ─── Phase 2: AI Policy Assistant ────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
# Without this key, policy upload works but embeddings are skipped (status=ready
# with empty embeddings). AI chat returns 503.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — defaults shown below
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ─── Phase 2: File Storage ────────────────────────────────────────────────────
#
# STORAGE_PROVIDER=local (default)
#   Files saved to STORAGE_LOCAL_DIR on the server filesystem.
#   ⚠ NOT persistent on Render free tier or any ephemeral deployment.
#   Fine for local development only.
#
# STORAGE_PROVIDER=gcs
#   Requires:
#     1. npm install @google-cloud/storage   (inside server/)
#     2. A Google Cloud project with a GCS bucket
#     3. A service account with roles/storage.objectAdmin on the bucket
#     4. One of:
#        a) GOOGLE_APPLICATION_CREDENTIALS pointing to the service account JSON key
#        b) Workload Identity (GKE, Cloud Run, Compute Engine) — no key file needed
#        c) `gcloud auth application-default login` for local testing with gcs
#     5. GCS_BUCKET set to your bucket name
#
#   Bucket security checklist:
#     - Do NOT enable allUsers or allAuthenticatedUsers access (keep private)
#     - Enable uniform bucket-level access
#     - Enable Object Versioning if you want soft-delete
#     - Enable Google-managed encryption (default) or CMEK
#     - Restrict CORS if needed (server-to-server access — no browser CORS needed)
#
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# GCS settings (only used when STORAGE_PROVIDER=gcs)
GCS_BUCKET=your-gcs-bucket-name

# Set path to service account JSON when NOT using Workload Identity
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

MAX_UPLOAD_MB=20

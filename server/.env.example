PORT=5000
NODE_ENV=development
MONGODB_URI=your_mongodb_atlas_uri_here
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
JWT_SECRET=your_long_random_jwt_secret_here
CLIENT_URL=http://localhost:5173
ADMIN_SEED_EMAIL=your_admin_email_to_bootstrap@example.com

# ─── Phase 2: AI Policy Assistant ────────────────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — defaults shown
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# ─── Phase 2: File Storage ────────────────────────────────────────────────────
# local = dev only (files in STORAGE_LOCAL_DIR, NOT persistent on Render free tier)
# gcs   = production (requires @google-cloud/storage and GCS_BUCKET)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads
GCS_BUCKET=your_gcs_bucket_name
MAX_UPLOAD_MB=20
